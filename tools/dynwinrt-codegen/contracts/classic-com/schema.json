{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.github.io/dynwinrt/contracts/classic-com/schema.json",
  "title": "dynwinrt Classic COM exact contract registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contracts"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "contracts": {
      "type": "array",
      "items": { "$ref": "#/$defs/contract" }
    }
  },
  "$defs": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryId",
        "familyId",
        "kind",
        "reason",
        "selector",
        "contract",
        "evidence",
        "validatedMetadata"
      ],
      "properties": {
        "entryId": { "type": "string", "pattern": "^[a-z0-9._-]+\\.v1$" },
        "familyId": {
          "enum": [
            "automation.safearray.v1",
            "windows.borrowed-hwnd-output.v1",
            "com.enumerator-next-exception.v1",
            "buffers.bounded-two-call.v1",
            "buffers.counted-buffer.v1",
            "com.ownership.v1",
            "com.semantic-hresult.v1",
            "graphics.private-data-hazard.v1",
            "wmi.conditional-output.v1",
            "com.sequential-stream-buffer.v1",
            "automation.idispatch-invoke.v1"
            ,"com.reserved-null-input.v1",
            "com.parameter-direction.v1"
            ,"shell.flag-selected-string.v1"
          ]
        },
        "kind": {
          "enum": [
            "ownership",
            "conditional-output",
            "counted-buffer",
            "bounded-two-call",
            "borrowed-handle",
            "enumerator-next",
            "safearray",
            "semantic-hresult",
            "compound-dispatch",
            "hazard"
            ,"null-input",
            "parameter-direction"
            ,"flag-selected-buffer"
          ]
        },
        "reason": { "type": "string", "minLength": 1 },
        "selector": { "$ref": "#/$defs/selector" },
        "contract": {
          "oneOf": [
            { "$ref": "#/$defs/conditionalOutput" },
            { "$ref": "#/$defs/outputOwnership" }
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "validatedMetadata": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/validatedMetadata" }
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface",
        "declaringIid",
        "method",
        "absoluteSlot",
        "parameterCount",
        "parameters",
        "sourceFingerprint"
      ],
      "properties": {
        "interface": { "$ref": "#/$defs/interface" },
        "declaringIid": { "$ref": "#/$defs/guid" },
        "method": { "type": "string", "minLength": 1 },
        "absoluteSlot": { "type": "integer", "minimum": 3 },
        "parameterCount": { "type": "integer", "minimum": 0 },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "sourceFingerprint": { "$ref": "#/$defs/sha256" }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "name", "iid"],
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "iid": { "$ref": "#/$defs/guid" }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "name",
        "nativeType",
        "pointerDepth",
        "direction",
        "optional",
        "constness",
        "constAttribute"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "name": { "type": "string", "minLength": 1 },
        "nativeType": { "type": "string", "minLength": 1 },
        "pointerDepth": { "type": "integer", "minimum": 0 },
        "direction": { "enum": ["in", "out", "inout"] },
        "optional": { "type": "boolean" },
        "constness": { "enum": ["const", "mutable", "mixed", "unspecified"] },
        "constAttribute": { "type": "boolean" }
      }
    },
    "conditionalOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicInputParameterIndices",
        "contextParameterIndex",
        "contextMustBeNativeNull",
        "flagsParameterIndex",
        "flagsOptionName",
        "synchronous",
        "semisynchronous",
        "outputs"
      ],
      "properties": {
        "publicInputParameterIndices": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "contextParameterIndex": { "type": "integer", "minimum": 0 },
        "contextMustBeNativeNull": { "const": true },
        "flagsParameterIndex": { "type": "integer", "minimum": 0 },
        "flagsOptionName": { "type": "string", "minLength": 1 },
        "synchronous": { "$ref": "#/$defs/outputMode" },
        "semisynchronous": { "$ref": "#/$defs/outputMode" },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/interfaceOutput" }
        }
      }
    },
    "outputOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameterIndex", "ownership", "cleanup"],
      "properties": {
        "parameterIndex": { "type": "integer", "minimum": 0 },
        "ownership": { "enum": ["cotaskmem-owned", "handle-owned"] },
        "cleanup": { "enum": ["CoTaskMemFree", "DeleteObject"] }
      }
    },
    "outputMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flags", "outputParameterIndex", "optionName"],
      "properties": {
        "flags": { "type": "integer" },
        "outputParameterIndex": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "optionName": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        }
      }
    },
    "interfaceOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameterIndex",
        "interfaceIid",
        "argumentOptional",
        "nullableOnSuccess",
        "ownership"
      ],
      "properties": {
        "parameterIndex": { "type": "integer", "minimum": 0 },
        "interfaceIid": { "$ref": "#/$defs/guid" },
        "argumentOptional": { "const": true },
        "nullableOnSuccess": { "const": false },
        "ownership": { "const": "owned-com-plus-one" }
      }
    },
    "evidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "url", "file"],
          "properties": {
            "kind": { "const": "microsoft-learn" },
            "url": { "type": "string", "format": "uri" },
            "file": { "type": "null" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "url", "file"],
          "properties": {
            "kind": { "const": "sdk-header" },
            "url": { "type": "null" },
            "file": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "validatedMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "sha256"],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    }
  }
}
