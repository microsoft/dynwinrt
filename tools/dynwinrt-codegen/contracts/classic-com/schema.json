{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.github.io/dynwinrt/contracts/classic-com/schema.json",
  "title": "dynwinrt Classic COM exact contract registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contracts"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "contracts": {
      "type": "array",
      "items": { "$ref": "#/$defs/contract" }
    }
  },
  "$defs": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryId",
        "familyId",
        "kind",
        "reason",
        "selector",
        "contract",
        "evidence",
        "validatedMetadata"
      ],
      "properties": {
        "entryId": { "type": "string", "pattern": "^[a-z0-9._-]+\\.v1$" },
        "familyId": {
          "enum": [
            "automation.safearray.v1",
            "windows.borrowed-hwnd-output.v1",
            "com.enumerator-next-exception.v1",
            "com.ownership.v1",
            "wmi.conditional-output.v1",
            "com.reserved-null-input.v1",
            "com.parameter-direction.v1"
          ]
        },
        "kind": {
          "enum": [
            "ownership",
            "conditional-output",
            "borrowed-handle",
            "enumerator-next",
            "safearray",
            "null-input",
            "parameter-direction"
          ]
        },
        "reason": { "type": "string", "minLength": 1 },
        "selector": { "$ref": "#/$defs/selector" },
        "contract": { "type": "object" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "validatedMetadata": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/validatedMetadata" }
        }
      },
      "oneOf": [
          {
            "properties": {
              "kind": { "const": "conditional-output" },
              "familyId": { "const": "wmi.conditional-output.v1" },
              "selector": { "not": { "required": ["sourceShape"] } },
              "contract": { "$ref": "#/$defs/conditionalOutput" }
            }
          },
          {
            "properties": {
              "kind": { "const": "ownership" },
              "familyId": { "const": "com.ownership.v1" },
              "selector": { "not": { "required": ["sourceShape"] } },
              "contract": { "$ref": "#/$defs/outputOwnership" }
            }
          },
          {
            "properties": {
              "kind": { "const": "safearray" },
              "familyId": { "const": "automation.safearray.v1" },
              "selector": { "required": ["sourceShape"] },
              "contract": { "$ref": "#/$defs/safeArray" }
            }
          },
          {
            "properties": {
              "kind": { "const": "borrowed-handle" },
              "familyId": { "const": "windows.borrowed-hwnd-output.v1" },
              "selector": { "required": ["sourceShape"] },
              "contract": { "$ref": "#/$defs/borrowedHandle" }
            }
          },
          {
            "properties": {
              "kind": { "const": "enumerator-next" },
              "familyId": { "const": "com.enumerator-next-exception.v1" },
              "selector": { "required": ["sourceShape"] },
              "contract": { "$ref": "#/$defs/enumerator" }
            }
          },
          {
            "properties": {
              "kind": { "const": "null-input" },
              "familyId": { "const": "com.reserved-null-input.v1" },
              "selector": { "not": { "required": ["sourceShape"] } },
              "contract": { "$ref": "#/$defs/nullInput" }
            }
          },
          {
            "properties": {
              "kind": { "const": "parameter-direction" },
              "familyId": { "const": "com.parameter-direction.v1" },
              "selector": { "not": { "required": ["sourceShape"] } },
              "contract": { "$ref": "#/$defs/parameterDirection" }
            }
          }
      ]
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface",
        "declaringIid",
        "method",
        "absoluteSlot",
        "parameterCount",
        "parameters",
        "sourceFingerprint"
      ],
      "properties": {
        "interface": { "$ref": "#/$defs/interface" },
        "declaringIid": { "$ref": "#/$defs/guid" },
        "method": { "type": "string", "minLength": 1 },
        "absoluteSlot": { "type": "integer", "minimum": 3 },
        "parameterCount": { "type": "integer", "minimum": 0 },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "sourceFingerprint": { "$ref": "#/$defs/sha256" },
        "sourceShape": { "$ref": "#/$defs/sourceShape" }
      }
    },
    "sourceShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "value"],
      "properties": {
        "format": { "const": "raw-method-shape-v1" },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "name", "iid"],
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "iid": { "$ref": "#/$defs/guid" }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "name",
        "nativeType",
        "pointerDepth",
        "direction",
        "optional",
        "constness",
        "constAttribute"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "name": { "type": "string", "minLength": 1 },
        "nativeType": { "type": "string", "minLength": 1 },
        "pointerDepth": { "type": "integer", "minimum": 0 },
        "direction": { "enum": ["in", "out", "inout"] },
        "optional": { "type": "boolean" },
        "constness": { "enum": ["const", "mutable", "mixed", "unspecified"] },
        "constAttribute": { "type": "boolean" }
      }
    },
    "conditionalOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicInputParameterIndices",
        "contextParameterIndex",
        "contextMustBeNativeNull",
        "flagsParameterIndex",
        "flagsOptionName",
        "synchronous",
        "semisynchronous",
        "outputs"
      ],
      "properties": {
        "publicInputParameterIndices": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "contextParameterIndex": { "type": "integer", "minimum": 0 },
        "contextMustBeNativeNull": { "const": true },
        "flagsParameterIndex": { "type": "integer", "minimum": 0 },
        "flagsOptionName": { "type": "string", "minLength": 1 },
        "synchronous": { "$ref": "#/$defs/outputMode" },
        "semisynchronous": { "$ref": "#/$defs/outputMode" },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/interfaceOutput" }
        }
      }
    },
    "outputOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameterIndex", "ownership", "cleanup"],
      "properties": {
        "parameterIndex": { "type": "integer", "minimum": 0 },
        "ownership": { "enum": ["cotaskmem-owned", "handle-owned"] },
        "cleanup": { "enum": ["CoTaskMemFree", "DeleteObject"] }
      },
      "oneOf": [
        {
          "properties": {
            "ownership": { "const": "cotaskmem-owned" },
            "cleanup": { "const": "CoTaskMemFree" }
          }
        },
        {
          "properties": {
            "ownership": { "const": "handle-owned" },
            "cleanup": { "const": "DeleteObject" }
          }
        }
      ]
    },
    "safeArray": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameterIndex", "element", "ownership", "cleanup", "nullability"],
      "properties": {
        "parameterIndex": { "type": "integer", "minimum": 0 },
        "element": { "$ref": "#/$defs/safeArrayElement" },
        "ownership": { "enum": ["borrowed-input", "owned-output"] },
        "cleanup": { "enum": ["none", "SafeArrayDestroy"] },
        "nullability": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "required-input" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "pointee"],
              "properties": {
                "kind": { "const": "required-output-cell" },
                "pointee": { "$ref": "#/$defs/safeArrayPointee" }
              }
            }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "ownership": { "const": "borrowed-input" },
            "cleanup": { "const": "none" },
            "nullability": { "properties": { "kind": { "const": "required-input" } } }
          }
        },
        {
          "properties": {
            "ownership": { "const": "owned-output" },
            "cleanup": { "const": "SafeArrayDestroy" },
            "nullability": { "properties": { "kind": { "const": "required-output-cell" } } }
          }
        }
      ]
    },
    "safeArrayElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vartype", "interfaceIid"],
      "properties": {
        "vartype": {
          "enum": ["VT_I4", "VT_UI1", "VT_UI4", "VT_R8", "VT_BSTR", "VT_UNKNOWN", "VT_VARIANT"]
        },
        "interfaceIid": { "oneOf": [{ "$ref": "#/$defs/guid" }, { "type": "null" }] }
      },
      "if": { "properties": { "vartype": { "const": "VT_UNKNOWN" } } },
      "then": { "properties": { "interfaceIid": { "$ref": "#/$defs/guid" } } },
      "else": { "properties": { "interfaceIid": { "type": "null" } } }
    },
    "safeArrayPointee": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "required" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason", "evidence"],
          "properties": {
            "kind": { "const": "nullable-on-success" },
            "reason": { "type": "string", "minLength": 1 },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/evidence" }
            }
          }
        }
      ]
    },
    "nullInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameterIndex", "value"],
      "properties": {
        "parameterIndex": { "type": "integer", "minimum": 0 },
        "value": { "const": "native-null" }
      }
    },
    "parameterDirection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameterIndex", "direction"],
      "properties": {
        "parameterIndex": { "type": "integer", "minimum": 0 },
        "direction": { "const": "out" }
      }
    },
    "borrowedHandle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameterIndex", "handle", "ownership", "cleanup", "receivingCell"],
      "properties": {
        "parameterIndex": { "type": "integer", "minimum": 0 },
        "handle": { "const": "Windows.Win32.Foundation.HWND" },
        "ownership": { "const": "borrowed" },
        "cleanup": { "const": "none" },
        "receivingCell": { "const": "required" }
      }
    },
    "enumerator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacityParameterIndex", "valuesParameterIndex", "fetchedParameterIndex",
        "element", "fetchedOptionalForSingle", "hresult", "evidenceSource"
      ],
      "properties": {
        "capacityParameterIndex": { "const": 0 },
        "valuesParameterIndex": { "const": 1 },
        "fetchedParameterIndex": { "const": 2 },
        "element": { "$ref": "#/$defs/enumeratorElement" },
        "fetchedOptionalForSingle": { "type": "boolean" },
        "hresult": { "const": "s-ok-s-false" },
        "evidenceSource": { "enum": ["com-standard", "exact-registry"] }
      }
    },
    "enumeratorElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "name", "kind", "iid"],
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["interface", "struct", "unknown"] },
        "iid": { "oneOf": [{ "$ref": "#/$defs/guid" }, { "type": "null" }] }
      },
      "if": { "properties": { "kind": { "const": "interface" } } },
      "then": { "properties": { "iid": { "$ref": "#/$defs/guid" } } },
      "else": { "properties": { "iid": { "type": "null" } } }
    },
    "outputMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flags", "outputParameterIndex", "optionName"],
      "properties": {
        "flags": { "type": "integer" },
        "outputParameterIndex": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "optionName": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        }
      }
    },
    "interfaceOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameterIndex",
        "interfaceIid",
        "argumentOptional",
        "nullableOnSuccess",
        "ownership"
      ],
      "properties": {
        "parameterIndex": { "type": "integer", "minimum": 0 },
        "interfaceIid": { "$ref": "#/$defs/guid" },
        "argumentOptional": { "const": true },
        "nullableOnSuccess": { "const": false },
        "ownership": { "const": "owned-com-plus-one" }
      }
    },
    "evidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "url", "file"],
          "properties": {
            "kind": { "const": "microsoft-learn" },
            "url": { "type": "string", "format": "uri" },
            "file": { "type": "null" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "url", "file"],
          "properties": {
            "kind": { "const": "sdk-header" },
            "url": { "type": "null" },
            "file": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "validatedMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "sha256"],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    }
  }
}
