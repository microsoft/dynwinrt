{
  "name": "dynwinrt-js-winui-tic-tac-toe-code-only-sample",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Code-only JavaScript WinUI Tic-Tac-Toe using dynwinrt",
  "scripts": {
    "check": "tsc --noEmit --allowJs --checkJs --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck app.mjs",
    "generate": "winapp node generate-bindings",
    "restore": "winapp restore",
    "start": "node app.mjs"
  },
  "imports": {
    "#winapp/bindings": {
      "types": "./.winapp/bindings/index.d.ts",
      "import": "./.winapp/bindings/index.mjs",
      "require": "./.winapp/bindings/index.js",
      "default": "./.winapp/bindings/index.js"
    },
    "#winapp/bindings/*": {
      "types": "./.winapp/bindings/*.d.ts",
      "default": "./.winapp/bindings/*.js"
    }
  },
  "dependencies": {
    "@microsoft/dynwinrt": "file:../../../bindings/js"
  },
  "devDependencies": {
    "@microsoft/dynwinrt-codegen": "file:../../../tools/dynwinrt-codegen/npm",
    "@microsoft/winappcli": "^0.6.2",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "winapp": {
    "jsBindings": {
      "additionalWinmds": [
        {
          "namespace": "Microsoft.UI.Xaml",
          "classes": [
            "Application",
            "Window"
          ]
        },
        {
          "namespace": "Microsoft.UI.Xaml.Controls",
          "classes": [
            "StackPanel",
            "Grid",
            "RowDefinition",
            "ColumnDefinition",
            "Button",
            "TextBlock"
          ]
        },
        {
          "namespace": "Microsoft.UI.Xaml.Automation",
          "classes": [
            "AutomationProperties"
          ]
        },
        {
          "namespace": "Microsoft.UI.Xaml.Media",
          "classes": [
            "MicaBackdrop"
          ]
        }
      ]
    }
  }
}
