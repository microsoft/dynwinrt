[run]
branch = True
parallel = True
relative_files = True

[report]
include =
    */dynwinrt/*
    tests/e2e/e2e_generated/python_bindings/*
omit =
    */__pycache__/*
    */site-packages/coverage/*
    bindings/py/tests/*
    tests/e2e/runners/*
